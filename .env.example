# ─── Azure Identity ──────────────────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_RESOURCE_GROUP=rg-omega-sare
AZURE_LOCATION=westeurope

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Google Gemini
GOOGLE_API_KEY=your-gemini-api-key-here

# GitHub (for Knowledge API Search)
GITHUB_PAT=your-github-personal-access-token-here

# Option B: Azure OpenAI (leave OPENAI_API_KEY blank and fill these)
AZURE_OPENAI_ENDPOINT=https://<your-instance>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ─── Backend / Database ───────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./vigilrag.db

# ─── Required security secrets (backend AND agent refuse to start without these) ─
# Use long random values. Do NOT leave the literal string "change-me-in-production".
INTERNAL_API_KEY=replace-me-with-a-long-random-internal-api-key
SECRET_KEY=replace-me-with-a-long-random-jwt-signing-secret
ADMIN_PASSWORD=replace-me-with-a-strong-admin-password

# ─── Audit / compliance (US-039) ──────────────────────────────────────────────
AUDIT_RETENTION_DAYS=365
AUDIT_EXPORT_TTL_SECONDS=3600
AUDIT_DIGEST_CHANNEL=log

# ─── Integrations ────────────────────────────────────────────────────────────
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_API_TOKEN=your-confluence-token

# ─── Switch: local subprocess vs Azure Container Instances ───────────────────
USE_ACI=false
